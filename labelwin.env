# ============================================================
#  Labelwin-Plugin fuer Claude - Zugangsdaten
# ============================================================
#  1. Werte hinter dem = eintragen (ohne Anfuehrungszeichen).
#  2. Speichern, dann einrichten.bat doppelklicken.
#     Die Datei wird nach %USERPROFILE%\.claude\labelwin.env kopiert
#     und dort vom Plugin gelesen - NICHT von Claude.
#
#  Diese Datei NICHT in den Plugin-Ordner legen und NICHT ins
#  Repo committen (sonst wird das Passwort mit hochgeladen).
# ============================================================

# Labelwin-Verzeichnis des Testsystems (Pflicht)
LW_HOME=C:\Testlabel5.100

# SQL Server und Datenbank
# Leer lassen = werden automatisch aus <LW_HOME>\global.ini gelesen
LW_DB_SERVER=
LW_DB_NAME=

# Lese-Benutzer (nur Leserechte, siehe sql\lesebenutzer_anlegen.sql)
LW_DB_USER=claude_ro
LW_DB_PASSWORD=

# Alternative ohne Passwort: Windows-Anmeldung verwenden
# Dann LW_DB_USER und LW_DB_PASSWORD leer lassen und hier 1 eintragen.
LW_DB_TRUSTED=
